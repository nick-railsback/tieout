# tieout — environment template
#
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.
# `.gitignore` ignores `.env` / `.env.*` but keeps this `.env.example` template.
#
# --- Mainnet RPC (Batch 2: derivation, verify, live-verify gates) -----------
#
# REQUIREMENT: a mainnet *archive* endpoint. tieout reads historical state at
# pinned old blocks — wstETH.stEthPerToken() at rebase blocks, Chainlink
# getRoundData(roundId)/decimals() at the pinned round, getBlock(n).timestamp.
# A pruned/full node (~128 blocks of state) will fail these reads.
#
# A free Alchemy key includes unrestricted archive access. Note the free tier
# caps eth_getLogs at a 10-block range per request, so the heavy verify
# re-fetch / CI harness prefer a small window or a higher-range endpoint
# (dRPC / PublicNode allow ~10k-block ranges); the live-verify gates are point
# reads and run fine on the free tier.

# Used by `cast` (foundry) and the `tieout verify` CLI (packages/recon).
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# Optional: eth_getLogs block-range per `verify` chunk (default 9, under the free
# tier's ~10-block cap). On a higher-range endpoint (dRPC/PublicNode, ~10k),
# raise it to make `verify` dramatically faster over large windows — it is a pure
# fetch/reliability knob and never affects the manifest hash (determinism is
# chunk-independent, see packages/recon/src/chunks.ts).
# VERIFY_CHUNK=9

# Used by the Ponder live adapter (packages/indexer/ponder.config.ts, chainId 1).
# Point it at the same archive endpoint as ETH_RPC_URL.
PONDER_RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# --- Base deploy ladder (Batch 3: AttestationRegistry anchor) ----------------
#
# REQUIREMENT (deploy only): the staged deploy ladder — local Anvil -> Base
# Sepolia (84532) rehearsal -> single Base mainnet (8453) canonical anchor —
# needs Base RPC endpoints, a Basescan/Etherscan key for source verification,
# and a funded deployer signer. NONE of these are needed to build, test, or
# fuzz the contract; only broadcasting the anchor touches them, and every
# non-local rung pauses for explicit approval. foundry.toml reads BASE_RPC_URL /
# BASE_SEPOLIA_RPC_URL / ETHERSCAN_API_KEY via ${VAR}, so no secret is committed.
#
# Base RPC endpoints. Current-state writes — NO archive tier needed (unlike the
# mainnet reads above). Alchemy serves Base; a public endpoint or another
# provider works too.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE

# Basescan source verification. Pass the Etherscan verifier + this key
# EXPLICITLY (`--verifier etherscan --etherscan-api-key`); without a key
# `forge verify-contract` silently falls back to Sourcify — an unverified anchor
# is indistinguishable from a scam. An Etherscan-V2 multichain key covers Base +
# Base Sepolia with one key; a plain Basescan key works for Base too.
ETHERSCAN_API_KEY=YOUR_BASESCAN_OR_ETHERSCAN_V2_KEY_HERE

# Deployer signer (non-local rungs only). PREFER a Foundry keystore account over
# a raw key — import once with
#   cast wallet import tieout-deployer --interactive
# then deploy with `--account tieout-deployer` (no private key on disk or in
# shell history). A raw key is supported by forge but discouraged; if you must,
# keep it in .env (gitignored) and NEVER commit it.
# DEPLOYER_PRIVATE_KEY=0x...
