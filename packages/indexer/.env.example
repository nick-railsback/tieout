# Mainnet RPC endpoint for the Ponder indexer. REQUIRED — `ponder start` hard-errors
# if it is unset or empty (see src/env.ts requirePonderRpcUrl / ponder.config.ts).
PONDER_RPC_URL_1=

# Ponder's anonymous telemetry is ON by default (60s heartbeat). Disable it for
# CI and reproducible runs.
# [ponder@0.16.6 packages/core/src/internal/telemetry.ts#L20-L56]
PONDER_TELEMETRY_DISABLED=1

# Production/CI database. With DATABASE_URL set, Ponder uses Postgres; otherwise
# it falls back to embedded PGlite for local dev. CI runners set DATABASE_SCHEMA
# and run `ponder start` (never `ponder dev`).
# DATABASE_URL=postgresql://user:pass@host:5432/tieout
# DATABASE_SCHEMA=tieout_indexer
